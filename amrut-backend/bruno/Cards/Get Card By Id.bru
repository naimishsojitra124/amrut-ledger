meta {
  name: Get Card By Id
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/cards/{{createdCardId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Correct id", () => {
    expect(body.id).to.equal(bru.getEnvVar("createdCardId"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}