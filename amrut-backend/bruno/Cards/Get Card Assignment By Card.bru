meta {
  name: Get Card Assignment By Card
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/cards/{{reassignedCardId}}/assignment
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Correct card id", () => {
    expect(body.cardId).to.equal(bru.getEnvVar("reassignedCardId"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}