meta {
  name: Make Card Available
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/cards/{{reassignedCardId}}/make-available
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Card released", () => {
    expect(body.cardId).to.equal(bru.getEnvVar("reassignedCardId"));
  });

  test("Assignment closed", () => {
    expect(body.unassignedAt).to.not.equal(null);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}