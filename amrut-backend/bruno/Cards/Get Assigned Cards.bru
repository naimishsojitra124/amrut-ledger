meta {
  name: Get Assigned Cards
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/cards/assigned
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Items exists", () => {
    expect(body.items).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}