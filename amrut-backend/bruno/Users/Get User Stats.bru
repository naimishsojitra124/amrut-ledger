meta {
  name: Get User Stats
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users/stats
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Total users exists", () => {
    expect(body.totalUsers).to.not.be.undefined;
  });

  test("Owner count exists", () => {
    expect(body.ownerCount).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}