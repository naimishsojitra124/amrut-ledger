meta {
  name: Create User
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "fullName": "{{userFullName}}",
    "mobileNumber": "{{userMobileNumber}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "role": "owner"
  }
}

vars:pre-request {
  userFullName: Naimish Sojitra
  userMobileNumber: 9316607575
  userEmail: naimishsojitra2002@gmail.com
  userPassword: Amrut@1068
}

script:pre-request {
  const suffix = String(Date.now()).slice(-9);
  bru.setEnvVar("userFullName", `Bruno User ${suffix}`);
  bru.setEnvVar("userMobileNumber", `7${suffix}`);
  bru.setEnvVar("userEmail", `bruno.user.${suffix}@example.com`);
  bru.setEnvVar("userPassword", "Password@123");
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("createdUserId", body.id);
}

tests {
  test("Status is 201", () => {
    expect(res.getStatus()).to.equal(201);
  });
  
  const body = res.getBody();
  
  test("User created", () => {
    expect(body.id).to.not.be.undefined;
  });
  
  test("Name matches", () => {
    expect(body.fullName).to.equal(bru.getEnvVar("userFullName"));
  });
  
  test("Role matches", () => {
    expect(body.role).to.equal("employee");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
