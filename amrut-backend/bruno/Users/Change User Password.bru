meta {
  name: Change User Password
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/users/{{createdUserId}}/password
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "password": "{{newUserPassword}}"
  }
}

script:pre-request {
  const suffix = String(Date.now()).slice(-4);
  bru.setEnvVar("newUserPassword", `NewPass@${suffix}`);
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Password change response contains user", () => {
    expect(body.id).to.equal(bru.getEnvVar("createdUserId"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}