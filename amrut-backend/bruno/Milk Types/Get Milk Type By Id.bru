meta {
  name: Get Milk Type By Id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/milk-types/{{milkTypeId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
  });
  
  const body = res.getBody();
  
  test("Correct id", () => {
      expect(body.id).to.equal(bru.getEnvVar("milkTypeId"));
  });
  
  test("Correct name", () => {
      expect(body.name).to.equal(bru.getEnvVar("milkTypeName"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
