meta {
  name: Archive Milk Type
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/milk-types/{{milkTypeId}}/archive
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
  });
  
  const body = res.getBody();
  
  test("Archived", () => {
      expect(body.status).to.equal("inactive");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
