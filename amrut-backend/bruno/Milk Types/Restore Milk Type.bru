meta {
  name: Restore Milk Type
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/milk-types/{{milkTypeId}}/restore
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
  });
  
  const body = res.getBody();
  
  test("Active again", () => {
      expect(body.status).to.equal("active");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
