meta {
  name: Delete Ledger Entry
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/customers/{{assignedCustomerId}}/ledgers/{{dailyLedgerDate}}/entries/0
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Entries exist", () => {
    expect(body.entries).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}