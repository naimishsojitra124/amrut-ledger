meta {
  name: Get Customer Ledgers
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/customers/{{assignedCustomerId}}/ledgers?month=6&year=2026
  body: none
  auth: inherit
}

params:query {
  month: 6
  year: 2026
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
  
  const body = res.getBody();
  
  test("Items exists", () => {
    expect(body.items).to.be.an("array");
  });
  
  test("Page info exists", () => {
    expect(body.pageInfo).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
