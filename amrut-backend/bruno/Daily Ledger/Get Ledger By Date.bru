meta {
  name: Get Ledger By Date
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/customers/{{assignedCustomerId}}/ledgers/{{dailyLedgerDate}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Correct date", () => {
    expect(body.ledgerDate).to.equal(bru.getEnvVar("dailyLedgerDate"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}