meta {
  name: Current user
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const body = res.getBody();
  
  test("User returned", function () {
      expect(body.user.id).to.not.equal(undefined);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
