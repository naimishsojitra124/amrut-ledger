meta {
  name: Get Bill By Id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/bills/{{billId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Correct id", () => {
    expect(body.id).to.equal(bru.getEnvVar("billId"));
  });

  test("Bill number exists", () => {
    expect(body.billNumber).to.not.be.undefined;
  });

  test("Payment summary exists", () => {
    expect(body.paymentSummary).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}