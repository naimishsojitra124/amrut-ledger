meta {
  name: Get Customer Bills
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/customers/{{customerId}}/bills
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Items exists", () => {
    expect(body.items).to.be.an("array");
  });

  test("Page info exists", () => {
    expect(body.pageInfo).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}