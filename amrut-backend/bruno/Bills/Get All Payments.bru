meta {
  name: Get All Payments
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/payments
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

script:post-response {
  const body = res.getBody();

  if (body.items?.[0]) {
    bru.setEnvVar("paymentId", body.items[0].id);
  }
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Items exists", () => {
    expect(body.items).to.be.an("array");
  });

  test("Page info exists", () => {
    expect(body.pageInfo).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}