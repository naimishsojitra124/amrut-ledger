meta {
  name: Get Payment By Id
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/payments/{{paymentId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  const body = res.getBody();

  test("Correct id", () => {
    expect(body.id).to.equal(bru.getEnvVar("paymentId"));
  });

  test("Receipt number exists", () => {
    expect(body.receiptNumber).to.not.be.undefined;
  });

  test("Bill exists", () => {
    expect(body.bill).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}