meta {
  name: Get Function Order Reminders
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/function-orders/reminders
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("gets function order reminders", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}
