meta {
  name: Get Function Orders
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/function-orders
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("lists function orders", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}
