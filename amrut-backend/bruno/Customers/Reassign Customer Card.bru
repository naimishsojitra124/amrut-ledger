meta {
  name: Reassign Customer Card
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/customers/{{customerId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "cardNumber": {{availableCardNumber}}
  }
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
  
  const body = res.getBody();
  
  test("Card exists", () => {
    expect(body.currentCard).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
