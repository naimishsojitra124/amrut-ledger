meta {
  name: Get Customer Daily History
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/customers/{{customerId}}/daily-history
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

tests {
  test("Status is 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}