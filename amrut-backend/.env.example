NODE_ENV=development
PORT=5000
HOST=0.0.0.0

DATABASE_URL="mongodb://localhost:27017/database-name"

JWT_ACCESS_SECRET="replace-with-a-32-character-minimum-access-secret"
JWT_REFRESH_SECRET="replace-with-a-32-character-minimum-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Required in production: comma-separated trusted frontend origins.
CORS_ORIGIN="http://localhost:3000"
# ── API documentation ──────────────────────────────────────────────────────
# Swagger UI at /docs. Defaults to on outside production, off in it: an
# unauthenticated map of every route is free reconnaissance on a public host.
# ENABLE_API_DOCS=false
# The origin shown in the OpenAPI document, so "Try it out" targets the right
# host rather than localhost.
# PUBLIC_API_URL="https://your-api.onrender.com"

# ── Function order reminders ───────────────────────────────────────────────
# A scheduler that builds the list of catering items to prepare for upcoming
# deliveries. Each order also carries its own "reminder days before" value,
# which decides when that order is flagged as due within this window.
# FUNCTION_REMINDER_ENABLED=true
# FUNCTION_REMINDER_DAYS_AHEAD=2
# FUNCTION_REMINDER_INTERVAL_MINUTES=60

# ── Public demo ────────────────────────────────────────────────────────────
# Opens the published guest login and wipes/re-seeds the database on a
# schedule. A demo deployment MUST have its own DATABASE_URL: the reset job
# deletes every collection in whatever database this points at.
# DEMO_MODE=false
# DEMO_GUEST_PASSWORD="GuestDemo2026"
# DEMO_RESET_INTERVAL_HOURS=6

# ── Seeding ────────────────────────────────────────────────────────────────
# `npm run seed` deletes everything, so it refuses to run unless you name the
# target database and it matches DATABASE_URL:
#   npm run seed -- --force --db amrut-demo
