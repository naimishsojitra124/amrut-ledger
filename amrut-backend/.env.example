NODE_ENV=development
PORT=5000
HOST=0.0.0.0

DATABASE_URL="mongodb://localhost:27017/database-name"

JWT_ACCESS_SECRET="replace-with-a-32-character-minimum-access-secret"
JWT_REFRESH_SECRET="replace-with-a-32-character-minimum-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Required in production: comma-separated trusted frontend origins.
CORS_ORIGIN="http://localhost:3000"

# --- Diagnostics (optional) ---------------------------------------------
# Deliberately independent of NODE_ENV: a deployment that forgets to set
# NODE_ENV=production must not silently turn these on.
# LOG_LEVEL=info
# LOG_PRETTY=false          # pino-pretty; useful at a terminal, wasteful on a server
# PRISMA_LOG_QUERIES=false  # logs every database query — very noisy

# --- Database transactions (optional) ------------------------------------
# Each statement inside a transaction is its own round trip. Raise these if the
# app and the database are far apart and you see P2028 "transaction already
# closed" errors. Check GET /health/db for your actual round-trip latency.
# DB_TRANSACTION_TIMEOUT_MS=20000
# DB_TRANSACTION_MAX_WAIT_MS=10000
